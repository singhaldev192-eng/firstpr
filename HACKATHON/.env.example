# FirstPR — Environment Configuration Template
# Copy this file to .env.local for local overrides.
# NOTE: All sensitive secrets (GitHub Personal Access Tokens, DigitalHost AI API keys, etc.)
# MUST remain on the backend server and never be exposed in client-side environment files.

# URL pointing to the partner backend server (leave empty or unset for offline/demo mode)
VITE_API_BASE_URL=http://localhost:8000

# Explicitly enable mock demo dataset fallback when backend is unreachable
VITE_ENABLE_DEMO_MODE=true

